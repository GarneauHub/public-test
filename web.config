<?xml version="1.0" encoding="UTF-8"?>
<!--
  Configuration IIS pour servir le frontend GarneauHub sous /hub
  (techinfo.cegepgarneau.ca est un serveur IIS / Windows).
  Ce fichier est dans frontend/public/ : Vite le copie tel quel dans dist/,
  et le workflow FTP le depose a la racine de /hub.
-->
<configuration>
  <system.webServer>
    <defaultDocument>
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>

    <rewrite>
      <rules>
        <rule name="SPA GarneauHub" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
          </conditions>
          <action type="Rewrite" url="/hub/index.html" />
        </rule>
      </rules>
    </rewrite>

    <staticContent>
      <remove fileExtension=".js" />
      <mimeMap fileExtension=".js" mimeType="text/javascript" />
      <remove fileExtension=".mjs" />
      <mimeMap fileExtension=".mjs" mimeType="text/javascript" />
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <remove fileExtension=".svg" />
      <mimeMap fileExtension=".svg" mimeType="image/svg+xml" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <!-- Extension VS Code GIFT (downloads/garneauhub-gift.vsix) : sans ce
           type, IIS refuse de servir le fichier (404). -->
      <remove fileExtension=".vsix" />
      <mimeMap fileExtension=".vsix" mimeType="application/vsix" />
    </staticContent>
  </system.webServer>
</configuration>
